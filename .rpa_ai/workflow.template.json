{
  "workflow_schema_version": "1.0.0",
  "template_version": "0.1.0",
  "template_repo": "https://github.com/redballoom/rpa-dev-template",
  "skills_repo": "https://github.com/redballoom/rpa-dev-template-skills",
  "required_skills": {
    "rpa-project-bootstrap": ">=0.1.0",
    "rpa-contract-business": ">=0.1.0",
    "rpa-fix-loop": ">=0.1.0",
    "rpa-gate-handoff": ">=0.1.0"
  },
  "current_gate": "initialized",
  "gates": [
    {
      "id": "initialized",
      "name": "项目初始化验收",
      "required_artifacts": [
        "README.md",
        "AGENTS.md",
        "docs/OPERATION_GUIDE.md",
        "project.template.json"
      ],
      "next": "contract_review"
    },
    {
      "id": "contract_review",
      "name": "业务契约确认",
      "required_artifacts": [
        "input contract",
        "task type table",
        "payload field table",
        "exception policy",
        "acceptance criteria"
      ],
      "next": "minimal_implementation"
    },
    {
      "id": "minimal_implementation",
      "name": "最小可运行实现",
      "required_artifacts": [
        "handler",
        "example input",
        "unit tests"
      ],
      "next": "runtime_verification"
    },
    {
      "id": "runtime_verification",
      "name": "运行验证",
      "required_artifacts": [
        "runner result",
        "logs",
        "test result"
      ],
      "next": "delivery"
    },
    {
      "id": "delivery",
      "name": "交付验收",
      "required_artifacts": [
        "operation notes",
        "acceptance checklist",
        "known risks"
      ],
      "next": "retrospective"
    },
    {
      "id": "retrospective",
      "name": "复盘沉淀",
      "required_artifacts": [
        "reusable patterns",
        "template update suggestions",
        "skill update suggestions"
      ],
      "next": ""
    }
  ],
  "handoff": {
    "current": ".rpa_ai/handoff/current.json",
    "history_dir": ".rpa_ai/handoff/history"
  }
}
