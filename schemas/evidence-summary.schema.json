{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redballoom/rpa-dev-template/schemas/evidence-summary.schema.json",
  "title": "Portable Sanitized RPA Run Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "runtime", "counts", "issue_groups", "artifacts", "integrity"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "status", "started_at", "finished_at", "commit", "working_tree_clean"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["success", "warning", "retryable_error", "pending_fix", "failed", "locked", "fatal"]},
        "started_at": {"type": "string"},
        "finished_at": {"type": "string"},
        "commit": {"type": "string", "pattern": "^([0-9a-fA-F]{40})?$"},
        "working_tree_clean": {"type": "boolean"},
        "delivery_tree_clean": {"type": "boolean"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "interpreter"],
      "properties": {
        "entrypoint": {"type": "string", "enum": ["run.bat", "runner.py"]},
        "interpreter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "version", "executable", "environment"],
          "properties": {
            "implementation": {"type": "string"},
            "version": {"type": "string"},
            "executable": {"type": "string"},
            "environment": {"type": "string", "enum": ["project_venv", "virtualenv", "system"]}
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks_planned", "tasks_recorded", "succeeded", "skipped", "failed", "warnings", "errors"],
      "properties": {
        "tasks_planned": {"type": "integer", "minimum": 0},
        "tasks_recorded": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    },
    "issue_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "code", "category", "retryable", "count"],
        "properties": {
          "kind": {"type": "string", "enum": ["warning", "error"]},
          "code": {"type": "string"},
          "category": {"type": "string"},
          "retryable": {"type": "boolean"},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "runner_output"],
      "properties": {
        "input": {"$ref": "#/$defs/artifact"},
        "runner_output": {"$ref": "#/$defs/artifact"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"properties": {"run": {"required": ["delivery_tree_clean"]}}},
      "else": {"properties": {"run": {"not": {"required": ["delivery_tree_clean"]}}}}
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "bytes", "sha256"],
      "properties": {
        "present": {"type": "boolean"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"}
      }
    }
  }
}
