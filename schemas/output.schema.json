{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redballoom/rpa-dev-template/schemas/output.schema.json",
  "title": "ShadowBot RPA Runner Output",
  "type": "object",
  "required": [
    "status",
    "message",
    "data"
  ],
  "properties": {
    "status": {
      "type": "string",
      "description": "运行状态。retryable_error 表示错误具有暂时性，不代表整个 tasks[] 可安全重放。",
      "enum": [
        "success",
        "warning",
        "retryable_error",
        "pending_fix",
        "locked",
        "fatal"
      ]
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "run_id",
        "results",
        "warnings",
        "errors",
        "retryable",
        "crash_snapshot_dir",
        "log_path"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "task",
              "status"
            ],
            "properties": {
              "task": {
                "type": "object"
              },
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "skipped",
                  "error"
                ]
              },
              "data": {},
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "retryable": {
          "type": "boolean",
          "description": "错误性质提示，不是调度层自动重放整个运行的授权。"
        },
        "crash_snapshot_dir": {
          "type": "string"
        },
        "log_path": {
          "type": "string"
        },
        "config_check": {
          "type": "object"
        },
        "traceback": {
          "type": "string"
        },
        "evidence_summary_path": {
          "type": "string",
          "pattern": "^evidence/runs/[A-Za-z0-9._-]+\\.summary\\.json$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
