{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redballoom/rpa-dev-template/schemas/workflow.schema.json",
  "title": "RPA AI Workflow",
  "type": "object",
  "required": [
    "workflow_schema_version",
    "template_version",
    "template_repo",
    "skills_repo",
    "required_skills",
    "current_gate",
    "gates",
    "handoff"
  ],
  "properties": {
    "workflow_schema_version": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    },
    "template_repo": {
      "type": "string"
    },
    "skills_repo": {
      "type": "string"
    },
    "required_skills": {
      "type": "object"
    },
    "current_gate": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "required_artifacts",
          "next"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "required_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "current",
        "history_dir"
      ],
      "properties": {
        "current": {
          "type": "string"
        },
        "history_dir": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
